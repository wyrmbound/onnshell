# Copy to scripts/.env (gitignored) and fill in.
# Box address on the LAN. Leave empty to use the single USB device.
ONN_HOST=192.168.1.50
ONN_PORT=5555
# Optional: full path to adb if it is not on PATH. Forward slashes work on Windows too.
# ADB=C:/Users/you/AppData/Local/Android/Sdk/platform-tools/adb.exe
